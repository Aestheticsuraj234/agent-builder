#!/bin/sh
# Resolve $0 through symlinks so basedir is the shim's real directory.
# Cap hops at the kernel's ELOOP limit so a cycle cannot hang the shim.
link="$0"
hops=0
while [ -L "$link" ] && [ "$hops" -lt 40 ]; do
  hops=$((hops+1))
  target=$(readlink "$link")
  case "$target" in
    /*) link="$target" ;;
    *)  link="$(dirname "$link")/$target" ;;
  esac
done
basedir=$(dirname "$(echo "$link" | sed -e 's,\\,/,g')")
basedir_win="$basedir"
exe=""
msys=""

case `uname -a` in
  *CYGWIN*|*MINGW*|*MSYS*)
    if command -v cygpath > /dev/null 2>&1; then
      basedir_win=`cygpath -w "$basedir"`
    fi
    exe=".exe"
    msys="true"
  ;;
  *WSL2*)
    if command -v wslpath > /dev/null 2>&1; then
      basedir_win="$(wslpath -w "$basedir" 2> /dev/null)"
      if [ $? -ne 0 ] || [ -z "$basedir_win" ]; then
        basedir_win="$basedir"
      else
        exe=".exe"
      fi
    fi
  ;;
esac

if [ -n "$exe" ] && [ -x "$basedir//bin/sh.exe" ]; then
  exec "$basedir//bin/sh.exe"  "$basedir_win/../node_modules/pnpm/pn" "$@"
elif [ -x "$basedir//bin/sh" ]; then
  exec "$basedir//bin/sh"  "$basedir/../node_modules/pnpm/pn" "$@"
elif command -v /bin/sh >/dev/null 2>&1; then
  exec /bin/sh  "$basedir/../node_modules/pnpm/pn" "$@"
elif [ -n "$exe" ] && command -v /bin/sh.exe >/dev/null 2>&1; then
  exec /bin/sh.exe  "$basedir_win/../node_modules/pnpm/pn" "$@"
else
  exec /bin/sh  "$basedir/../node_modules/pnpm/pn" "$@"
fi
# cmd-shim-target=/Users/surajjha/coding-playground/agent-builder/.pnpm-store/v11/links/@/pnpm/12.6.0/ef0b52f9ab1a46458da716a61bde3bc0b8d462841d57df9d129e4e9b02a6ef6f/node_modules/pnpm/pn
